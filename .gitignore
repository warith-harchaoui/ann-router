# Byte-compiled / optimized / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/
.env

# Local index artefacts produced by `ann-router build`
*.idx
*.idx.meta.json
*.ann
*.ann.ids.npy
*.tv
*.faiss

# Local Postgres/pgvector test server (see INSTALL.md — never commit the data dir)
.pgdata/
.pgdata.log

# bench/: measurements.yaml IS the tracked evidence; the ground-truth cache is
# pure regenerable derived data (see bench/datagen.py) and not worth the bytes.
bench/results/gt/

# Editor / OS noise
.DS_Store
.idea/
.vscode/

# Real config files (keep the *.example / packaged YAML tracked)
*config.json
!*config.json.example

# Private data (not tracked)
.private/

# Local build/helper scripts (not tracked)
scripts/
